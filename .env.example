# ─── Telegram API credentials ────────────────────────────────────────────────
# Get these from https://my.telegram.org  →  "API development tools"
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# ─── Login session ────────────────────────────────────────────────────────────
# LOCAL : leave SESSION_STRING empty — a userbot.session file is made on first
#         run (log in once with phone + code).
# CLOUD : run `python gen_session.py` once, paste the result here / into the host.
SESSION_STRING=
# SESSION_NAME=userbot

# ─── Control chat (where you type commands) ───────────────────────────────────
# me = your Saved Messages (default). Or a chat/channel id you own.
CONTROL_CHAT=me

# ─── Starting config (defaults; you can change everything live via commands) ──
# Targets: me = Saved Messages. Comma-separate for several. @user or -100id too.
TARGET_CHANNELS=me

# Sources: comma list, each may carry an optional start date for backfill:
#   @chanA 2026-01-02, @chanB 2026-02-01, @chanC
# If empty, channels.txt is read instead (one per line, same "@chan DATE" form).
# SOURCE_CHANNELS=@chanA 2026-01-02,@chanB 2026-02-01

# What to pass:  all | video | image | zip | document
FORWARD_MODE=all

# Fixed caption applied to everything sent.
# CAPTION=Follow @mychannel
CAPTION_MODE=replace            # replace | append | off

# Keep the "Forwarded from" label? false = always copy (looks original).
KEEP_FORWARD_LABEL=false

# Skip messages containing these words / any link.
# BAN_WORDS=promo,giveaway
DROP_LINKS=false

# Content-protected channels: notice = post PRIVATE_NOTICE; skip = ignore silently.
PRIVATE_ACTION=notice
PRIVATE_NOTICE=🔒 This is private

# Manual relay: forward/send to INBOX chat → it goes to the target(s).
# INBOX=me
RELAY_ENABLED=false

# Live auto-forward on by default.
LIVE_ENABLED=true

# ─── Paths / tuning ───────────────────────────────────────────────────────────
# SETTINGS_FILE=data/settings.json   # command changes are saved here
# MAP_DB=data/msgmap.db              # edit/delete id-map
# CHANNELS_FILE=channels.txt
# BACKFILL_DELAY=2                   # seconds between sends during backfill
DASHBOARD=off
